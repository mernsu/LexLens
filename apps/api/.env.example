# 复制为 .env 后按需修改；.env 不入库
# api 端口 8010：8000 已被本机其他项目占用

APP_ENV=development

# 允许跨源访问的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# 监听端口不在此配置：由根 package.json 的 dev:api 脚本传 --port 8010，单一来源

# 存储层，P0 尚未接入，先占位
DATABASE_URL=postgresql://lexlens:lexlens@127.0.0.1:5432/lexlens
REDIS_URL=redis://127.0.0.1:6379/0
